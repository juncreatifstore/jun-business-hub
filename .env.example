# ══════════════════ JUN Business Hub — environment ══════════════════
# Copy to .env for local dev. NEVER commit real values.

# ── App ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.juncreatif.org

# ── Database (Supabase PostgreSQL) ─────────────────────────────────
# DATABASE_URL: pooled connection (pgbouncer, port 6543) — runtime
# DIRECT_URL:   direct connection (port 5432) — Prisma migrations
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"

# ── Auth ───────────────────────────────────────────────────────────
# openssl rand -base64 32 — also derives the AES key for stored secrets
# (rotating it invalidates sessions AND requires reconnecting Gmail/MFA).
AUTH_SECRET=

# ── Supabase Storage (private bucket "jun-files") ──────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser. NEVER commit.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE | LOCAL (LOCAL is dev-only, files under ./storage-dev)
STORAGE_DRIVER=LOCAL

# ── JUN AI (Vercel AI SDK + OpenAI provider) ───────────────────────
OPENAI_API_KEY=
# Optional model override (default gpt-4o-mini)
OPENAI_MODEL=

# ── Gmail (Google OAuth 2.0) — READY, CREDENTIALS REQUIRED ─────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.juncreatif.org/api/google/oauth/callback

# ── E-signature ────────────────────────────────────────────────────
# MOCK (dev only) | DOCUSIGN
SIGNATURE_PROVIDER=MOCK
# DocuSign JWT grant — READY, CREDENTIALS REQUIRED
DOCUSIGN_CLIENT_ID=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_PATH=https://demo.docusign.net
DOCUSIGN_OAUTH_BASE=account-d.docusign.com
# RSA private key with \n-escaped newlines
DOCUSIGN_PRIVATE_KEY=
# HMAC key configured in DocuSign Connect for the webhook /api/webhooks/docusign
DOCUSIGN_WEBHOOK_SECRET=

# ── Payments (abstraction; MANUAL is the active V1 mode) ───────────
# MANUAL | STRIPE | PAYPAL | MERCADO_PAGO
PAYMENT_PROVIDER=MANUAL

# ── Rate limiting ──────────────────────────────────────────────────
# (empty=MEMORY) | UPSTASH
RATE_LIMIT_PROVIDER=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Seed (dev only) ────────────────────────────────────────────────
SEED_ADMIN_PASSWORD=
