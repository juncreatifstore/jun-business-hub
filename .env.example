# ══════════════════ JUN Business Hub — environment ══════════════════
# Copy to .env for local dev. NEVER commit real values.

# ── App ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.juncreatif.org

# ── Database (Supabase PostgreSQL) ─────────────────────────────────
# DATABASE_URL: pooled connection (pgbouncer, port 6543) — runtime
# DIRECT_URL:   direct connection (port 5432) — Prisma migrations
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"

# ── Auth ───────────────────────────────────────────────────────────
# openssl rand -base64 32 — also derives the AES key for stored secrets
AUTH_SECRET=

# ── Supabase Storage ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_DRIVER=LOCAL

# ── JUN AI ─────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=

# ── Gmail ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.juncreatif.org/api/google/oauth/callback

# ── E-signature ────────────────────────────────────────────────────
SIGNATURE_PROVIDER=MOCK
DOCUSIGN_CLIENT_ID=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_PATH=https://demo.docusign.net
DOCUSIGN_OAUTH_BASE=account-d.docusign.com
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_WEBHOOK_SECRET=

# ── Payments ───────────────────────────────────────────────────────
# Legacy/default provider selector. Finance Phase 3 can use multiple providers.
PAYMENT_PROVIDER=MANUAL

# Stripe — server-side only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Configure webhook URL: https://www.juncreatif.org/api/webhooks/stripe

# PayPal — server-side only
# sandbox | live
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Configure webhook URL: https://www.juncreatif.org/api/webhooks/paypal

# Mercado Pago — server-side only
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# Configure webhook URL: https://www.juncreatif.org/api/webhooks/mercado-pago

# ── Rate limiting ──────────────────────────────────────────────────
RATE_LIMIT_PROVIDER=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Seed (dev only) ────────────────────────────────────────────────
SEED_ADMIN_PASSWORD=
