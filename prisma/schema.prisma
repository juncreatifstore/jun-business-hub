// JUN Business Hub — Prisma Schema
// PostgreSQL (Supabase). IDs use cuid() consistently.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["queryCompiler", "driverAdapters"]
  engineType      = "client" // WASM query compiler — no native engine download (Vercel/CI friendly)
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────── AUTH / TEAM ───────────────────────────

enum RoleName {
  SUPER_ADMIN
  DIRECTOR
  ADMIN
  MANAGER
  FINANCE
  TRAVEL_AGENT
  DOCUMENT_AGENT
  LEGAL
  ACCOUNTANT
  AUDITOR
  VIEWER
  CLIENT // client-portal accounts — never mixed with staff permissions
}

enum DepartmentName {
  EXECUTIVE
  ADMINISTRATION
  FINANCE
  TRAVEL
  DOCUMENTS
  LEGAL
  ACCOUNTING
  CUSTOMER_SERVICE
  TECHNOLOGY
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
  DISABLED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  role          RoleName   @default(VIEWER)
  status        UserStatus @default(ACTIVE)
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  mfaEnabled    Boolean    @default(false)
  mfaSecret     String? // TOTP secret, AES-256-GCM encrypted (see lib/crypto.ts) — MFA is live
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // extra per-user permission overrides (grants beyond role)
  extraPermissions UserPermission[]

  clientsOwned    Client[]        @relation("ClientOwner")
  casesOwned      Case[]          @relation("CaseOwner")
  caseMemberships CaseMember[]
  tasksAssigned   Task[]          @relation("TaskAssignee")
  tasksCreated    Task[]          @relation("TaskCreator")
  clientNotes     ClientNote[]
  caseNotes       CaseNote[]
  filesUploaded   File[]
  documents       Document[]      @relation("DocumentAuthor")
  docVersions     DocumentVersion[]
  payments        Payment[]       @relation("PaymentCreator")
  refundsCreated  Refund[]        @relation("RefundCreator")
  refundsApproved Refund[]        @relation("RefundApprover")
  notifications   Notification[]
  activities      Activity[]
  auditLogs       AuditLog[]
  aiConversations AIConversation[]
  aiActionsProposed AIAction[]    @relation("AIActionProposer")
  aiActionsReviewed AIAction[]    @relation("AIActionReviewer")
  signatureRequests SignatureRequest[]
  sessions        Session[]
  clientAccount   ClientAccount?
  mailAccounts    MailAccount[]
  recoveryCodes   RecoveryCode[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Role {
  id          String           @id @default(cuid())
  name        RoleName         @unique
  label       String
  description String?
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(cuid())
  code  String           @unique // e.g. CLIENT_READ
  label String
  roles RolePermission[]
  users UserPermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserPermission {
  userId       String
  permissionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model Department {
  id    String         @id @default(cuid())
  name  DepartmentName @unique
  label String
  users User[]
}

// ─────────────────────────── CRM ───────────────────────────

enum ClientStatus {
  LEAD
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Client {
  id          String       @id @default(cuid())
  internalId  String       @unique // e.g. JUN-CLI-2026-000001
  firstName   String
  lastName    String
  email       String?
  phone       String?
  whatsapp    String?
  address     String?
  country     String?
  nationality String?
  birthDate   DateTime?
  notes       String?
  status      ClientStatus @default(ACTIVE)
  ownerId     String?
  owner       User?        @relation("ClientOwner", fields: [ownerId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  archivedAt  DateTime?

  tags        ClientTag[]
  clientNotes ClientNote[]
  cases       Case[]
  tasks       Task[]
  files       File[]
  documents   Document[]
  payments    Payment[]
  refunds     Refund[]
  receipts    Receipt[]
  emailThreads EmailThread[]
  activities  Activity[]
  account     ClientAccount?

  @@index([lastName, firstName])
  @@index([email])
}

model ClientTag {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag      String

  @@unique([clientId, tag])
}

model ClientNote {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

// Client portal accounts — strictly separated from staff Users.
model ClientAccount {
  id           String   @id @default(cuid())
  clientId     String   @unique
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId       String?  @unique
  user         User?    @relation(fields: [userId], references: [id])
  email        String   @unique
  passwordHash String?
  isEnabled    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// ─────────────────────────── CASES ───────────────────────────

enum CaseStatus {
  OPEN
  IN_PROGRESS
  WAITING_CLIENT
  WAITING_INTERNAL
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Case {
  id          String     @id @default(cuid())
  caseNumber  String     @unique // CASE-2026-000001
  clientId    String
  client      Client     @relation(fields: [clientId], references: [id])
  type        String
  title       String
  description String?
  status      CaseStatus @default(OPEN)
  priority    Priority   @default(MEDIUM)
  ownerId     String?
  owner       User?      @relation("CaseOwner", fields: [ownerId], references: [id])
  dueDate     DateTime?
  tags        String[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  members   CaseMember[]
  notes     CaseNote[]
  tasks     Task[]
  files     File[]
  documents Document[]
  payments  Payment[]
  refunds   Refund[]
  emailThreads EmailThread[]
  activities Activity[]

  @@index([clientId])
  @@index([status])
}

model CaseMember {
  caseId String
  userId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([caseId, userId])
}

model CaseNote {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

// ─────────────────────────── TASKS ───────────────────────────

enum TaskStatus {
  TODO
  IN_PROGRESS
  WAITING
  DONE
  CANCELLED
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  caseId      String?
  case        Case?      @relation(fields: [caseId], references: [id])
  clientId    String?
  client      Client?    @relation(fields: [clientId], references: [id])
  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creatorId   String
  creator     User       @relation("TaskCreator", fields: [creatorId], references: [id])
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  status      TaskStatus @default(TODO)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([assigneeId, status])
}

// ─────────────────────────── DRIVE / FILES ───────────────────────────

enum FileCategory {
  IDENTITY
  PASSPORT
  CONTRACT
  PAYMENT_PROOF
  RECEIPT
  REFUND
  VISA
  FLIGHT
  INVOICE
  COMPANY
  LEGAL
  TAX
  EMPLOYEE
  VENDOR
  OTHER
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  parent    Folder?  @relation("FolderTree", fields: [parentId], references: [id])
  children  Folder[] @relation("FolderTree")
  isVault   Boolean  @default(false)
  createdAt DateTime @default(now())
  files     File[]
}

model File {
  id           String       @id @default(cuid())
  name         String
  storageKey   String       @unique
  mimeType     String
  sizeBytes    Int
  category     FileCategory @default(OTHER)
  folderId     String?
  folder       Folder?      @relation(fields: [folderId], references: [id])
  isVault      Boolean      @default(false)
  vaultCategory String? // Company Legal, Banking, Tax, Licenses, Insurance, Corporate Contracts, Sensitive
  clientId     String?
  client       Client?      @relation(fields: [clientId], references: [id])
  caseId       String?
  case         Case?        @relation(fields: [caseId], references: [id])
  paymentId    String?
  payment      Payment?     @relation(fields: [paymentId], references: [id])
  refundId     String?
  refund       Refund?      @relation(fields: [refundId], references: [id])
  uploadedById String
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  archivedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([clientId])
  @@index([caseId])
}

// ─────────────────────────── DOCUMENTS ───────────────────────────

enum DocumentType {
  CONTRACT
  AGREEMENT
  REFUND_AGREEMENT
  RECEIPT
  INVOICE
  LETTER
  ATTESTATION
  AUTHORIZATION
  REPORT
  CUSTOM
}

enum DocumentStatus {
  DRAFT
  FINAL
  SIGNED
  ARCHIVED
  VOIDED
}

model Document {
  id           String         @id @default(cuid())
  documentId   String         @unique // JUN-CTR-2026-000001
  type         DocumentType
  title        String
  status       DocumentStatus @default(DRAFT)
  clientId     String?
  client       Client?        @relation(fields: [clientId], references: [id])
  caseId       String?
  case         Case?          @relation(fields: [caseId], references: [id])
  authorId     String
  author       User           @relation("DocumentAuthor", fields: [authorId], references: [id])
  finalHash    String? // SHA-256 of final content
  finalizedAt  DateTime?
  finalPdfKey  String? // storage key of the generated final PDF
  finalPdfHash String? // SHA-256 of the final PDF bytes (tamper detection)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  versions          DocumentVersion[]
  signatureRequests SignatureRequest[]

  @@index([clientId])
  @@index([caseId])
}

enum DocumentVersionStatus {
  DRAFT
  FINAL
  SIGNED
}

model DocumentVersion {
  id          String                @id @default(cuid())
  documentId  String
  document    Document              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version     Int
  content     String // HTML content
  authorId    String
  author      User                  @relation(fields: [authorId], references: [id])
  changeNote  String?
  hash        String // SHA-256 of content
  status      DocumentVersionStatus @default(DRAFT)
  createdAt   DateTime              @default(now())

  @@unique([documentId, version])
}

model DocumentTemplate {
  id        String       @id @default(cuid())
  name      String
  type      DocumentType
  content   String // HTML with {{placeholders}}
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// ─────────────────────────── SIGNATURES ───────────────────────────

enum SignatureStatus {
  DRAFT
  READY_FOR_SIGNATURE
  SENT
  VIEWED
  PARTIALLY_SIGNED
  SIGNED
  DECLINED
  EXPIRED
  VOIDED
}

model SignatureRequest {
  id                 String          @id @default(cuid())
  documentId         String
  document           Document        @relation(fields: [documentId], references: [id])
  provider           String          @default("MOCK") // MOCK | DOCUSIGN | DROPBOX_SIGN
  providerEnvelopeId String?
  status             SignatureStatus @default(DRAFT)
  createdById        String
  createdBy          User            @relation(fields: [createdById], references: [id])
  signedPdfKey       String? // storage key of signed PDF
  finalHash          String?
  auditTrail         Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  signers            Signer[]
}

model Signer {
  id                 String    @id @default(cuid())
  signatureRequestId String
  request            SignatureRequest @relation(fields: [signatureRequestId], references: [id], onDelete: Cascade)
  name               String
  email              String
  order              Int       @default(1)
  signedAt           DateTime?
  ip                 String?
}

// ─────────────────────────── FINANCE ───────────────────────────

enum PaymentMethod {
  ZELLE
  STRIPE
  PAYPAL
  MERCADO_PAGO
  BANK_TRANSFER
  CASH
  MONCASH
  OTHER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id        String        @id @default(cuid())
  reference String        @unique // PAY-2026-000001
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id])
  caseId    String?
  case      Case?         @relation(fields: [caseId], references: [id])
  amount    Decimal       @db.Decimal(12, 2)
  currency  String        @default("USD")
  method    PaymentMethod
  paidAt    DateTime      @default(now())
  status    PaymentStatus @default(PENDING)
  notes     String?
  createdById String
  createdBy User          @relation("PaymentCreator", fields: [createdById], references: [id])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  proofs   File[]
  receipt  Receipt?
  refunds  Refund[]

  @@index([clientId])
  @@index([status])
}

model Receipt {
  id        String   @id @default(cuid())
  reference String   @unique // REC-2026-000001
  paymentId String   @unique
  payment   Payment  @relation(fields: [paymentId], references: [id])
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  amount    Decimal  @db.Decimal(12, 2)
  currency  String
  reason    String?
  issuedAt  DateTime @default(now())
  pdfKey    String? // storage key of generated PDF
}

enum RefundStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_PAID
  PAID
  REJECTED
  CANCELLED
}

model Refund {
  id              String       @id @default(cuid())
  reference       String       @unique // REF-2026-000001
  clientId        String
  client          Client       @relation(fields: [clientId], references: [id])
  caseId          String?
  case            Case?        @relation(fields: [caseId], references: [id])
  paymentId       String?
  payment         Payment?     @relation(fields: [paymentId], references: [id])
  amount          Decimal      @db.Decimal(12, 2)
  currency        String       @default("USD")
  reason          String
  status          RefundStatus @default(REQUESTED)
  createdById     String
  createdBy       User         @relation("RefundCreator", fields: [createdById], references: [id])
  approvedById    String?
  approvedBy      User?        @relation("RefundApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  installments RefundInstallment[]
  attachments  File[]

  @@index([clientId])
  @@index([status])
}

enum InstallmentStatus {
  SCHEDULED
  PAID
  LATE
  CANCELLED
}

model RefundInstallment {
  id       String            @id @default(cuid())
  refundId String
  refund   Refund            @relation(fields: [refundId], references: [id], onDelete: Cascade)
  dueDate  DateTime
  amount   Decimal           @db.Decimal(12, 2)
  status   InstallmentStatus @default(SCHEDULED)
  paidAt   DateTime?
}

// ─────────────────────────── CONTACT / MAIL ───────────────────────────

model ContactRequest {
  id         String   @id @default(cuid())
  firstName  String
  lastName   String
  phone      String?
  email      String
  subject    String
  department String
  message    String
  aiCategory String? // optional AI classification label (set by JUN AI triage when enabled)
  handled    Boolean  @default(false)
  createdAt  DateTime @default(now())
}

enum EmailAILevel {
  AUTO
  APPROVAL_REQUIRED
  BLOCKED
}

model EmailThread {
  id        String   @id @default(cuid())
  subject   String
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id])
  folder    String   @default("INBOX") // INBOX | SENT | DRAFTS | IMPORTANT | AI_REVIEW
  aiLevel   EmailAILevel @default(APPROVAL_REQUIRED)
  aiSummary String?
  urgency   Priority?
  gmailThreadId String? @unique // Gmail thread id when synced
  unread    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  EmailMessage[]
}

model EmailMessage {
  id        String      @id @default(cuid())
  threadId  String
  thread    EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  fromAddr  String
  toAddr    String
  body      String
  isDraft   Boolean     @default(false)
  isAIDraft Boolean     @default(false)
  gmailId   String?     @unique // Gmail message id when synced
  snippet   String?
  sentAt    DateTime?
  createdAt DateTime    @default(now())
}

// ─────────────────────────── NOTIFICATIONS / ACTIVITY / AUDIT ───────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // DOCUMENT_NEW, CONTRACT_SIGNED, REFUND_DUE, EMAIL_URGENT, TASK_OVERDUE, PAYMENT_CONFIRMED, CASE_IDLE
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
}

model Activity {
  id           String   @id @default(cuid())
  type         String // CLIENT_CREATED, CASE_CREATED, FILE_UPLOADED, PAYMENT_*, REFUND_*, DOCUMENT_*, SIGNATURE_*, EMAIL_*, TASK_*, UPDATED
  message      String
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id])
  caseId       String?
  case         Case?    @relation(fields: [caseId], references: [id])
  resourceType String?
  resourceId   String?
  createdAt    DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([caseId, createdAt])
}

// Append-only at the application level: no update/delete paths exist in code.
model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  action       String
  resourceType String
  resourceId   String?
  ip           String?
  userAgent    String?
  before       Json?
  after        Json?
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([createdAt])
}

// ─────────────────────────── AI ───────────────────────────

model AIConversation {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  title     String      @default("New conversation")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AIMessage[]
  actions   AIAction[]
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant | tool
  content        String
  createdAt      DateTime       @default(now())
}

enum AIActionStatus {
  PROPOSED
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

model AIAction {
  id             String         @id @default(cuid())
  conversationId String?
  conversation   AIConversation? @relation(fields: [conversationId], references: [id])
  type           String // SEND_EMAIL, CREATE_DOCUMENT_DRAFT, CREATE_RECEIPT_DRAFT ...
  payload        Json
  status         AIActionStatus @default(PROPOSED)
  proposedById   String
  proposedBy     User           @relation("AIActionProposer", fields: [proposedById], references: [id])
  reviewedById   String?
  reviewedBy     User?          @relation("AIActionReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  executedAt     DateTime?
  error          String?
  createdAt      DateTime       @default(now())
}

// ─────────────────────────── SETTINGS / SEQUENCES ───────────────────────────

// Connected mailbox (Gmail via OAuth). Refresh token stored AES-256-GCM encrypted.
model MailAccount {
  id            String   @id @default(cuid())
  provider      String   @default("GOOGLE")
  email         String   @unique
  refreshTokenEnc String? // encrypted, never sent to the client
  accessToken   String?
  tokenExpiry   DateTime?
  scope         String?
  historyId     String?
  status        String   @default("CONNECTED") // CONNECTED | REVOKED | ERROR
  connectedById String
  connectedBy   User     @relation(fields: [connectedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// MFA recovery codes — hashed, single-use.
model RecoveryCode {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  usedAt   DateTime?

  @@index([userId])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Server-side atomic numbering for CASE / documents / payments / receipts / refunds / clients
model SequenceCounter {
  id    String @id // e.g. "CASE-2026", "JUN-CTR-2026", "REC-2026"
  value Int    @default(0)
}
